{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@cc-heart/acp-hub-adapter-claude": "workspace:*",
    "@cc-heart/acp-hub-adapter-codex": "workspace:*",
    "@cc-heart/acp-hub-adapter-pi": "workspace:*",
    "@cc-heart/acp-hub-core": "workspace:*",
    "@cc-heart/open-chat-types": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
