# Server configuration is now loaded from a TOML file.
# Copy config/providers.example.toml -> config/providers.toml and fill in keys.
#
# Optional overrides:
# CONFIG_PATH=config/providers.toml   # path to the config file
#
# Provider store (user-added providers from the settings UI):
# PROVIDER_STORE_PATH=config/providers.json  # where user-added providers live
# PROVIDER_ENCRYPTION_KEY=<64 hex chars>     # AES-256-GCM key for encrypting
#                                            # stored API keys. When unset, the
#                                            # server auto-generates
#                                            # config/.provider-store-key (0600).
#
# Stored API keys may reference environment variables (pi-style), e.g.:
#   apiKey = "$OPENCODE_API_KEY"   # or $DEEPSEEK_API_KEY
# The key is then resolved from the server environment at request time.
#
# The previous .env-based keys (QWEN_API_KEY, OPENAI_*, PORT, HOST) are no longer
# used. Migrate them into config/providers.toml instead.
