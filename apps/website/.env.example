# API Configuration
# Leave empty to use the Vite dev proxy (recommended): `/api` -> http://localhost:8082
# Set to the gateway URL to bypass the proxy (e.g. http://localhost:8082).
# VITE_API_URL=http://localhost:8082

# Optional gateway bearer token. Only required when the gateway enables auth
# (gateway_api_key set in apps/server/config/providers.toml).
# VITE_GATEWAY_API_KEY=change-me
