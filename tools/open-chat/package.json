{
  "name": "@cc-heart/open-chat",
  "version": "0.0.1",
  "description": "Open Chat local AI CLI workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cc-hearts/open-chat.git",
    "directory": "tools/open-chat"
  },
  "bin": {
    "open-chat": "./bin/open-chat.mjs"
  },
  "files": [
    "bin",
    "dist",
    "website-dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --external:express --external:cors --external:@agentclientprotocol/sdk --platform=node --format=cjs --target=node22 --outfile=dist/cli.cjs --banner:js=\"#!/usr/bin/env node\" --sourcemap --sources-content=false --minify",
    "dev": "tsx src/cli.ts",
    "start": "node bin/open-chat.mjs",
    "prepack": "pnpm --dir ../.. run build:package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^2.8.19",
    "@types/node": "^24.12.0",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "server": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
